  "cards": [
    {
      "dot": "cyan",
      "title": "判断与程序执行分工",
      "items": [
        "宿主提交候选事实、章节计划、解释文字和审阅结论；CLI 不自动调用写作模型。",
        "程序校验原件定位与口径，执行注册指标、章节依赖、引用替换、完整性检查与版本写入。",
        "专业检索由场景开启；取证链共享，不是授信专属。"
      ]
    },
    {
      "dot": "emerald",
      "title": "三个场景共用流程",
      "items": [
        "预算：单位 / 板块 / 专项各守口径；逐户覆盖，逐份声明材料用途；可比时生成注册差额、变化率、完成率及单位图。",
        "授信：围绕业务单位与授信事项写风险审查；额度、等级与期限依据来自外部流程，不由报告引擎推算。",
        "薪酬：工资与花名册由注册程序聚合；未配置小样本阈值或口径时隐藏，正文检查个人信息。"
      ]
    },
    {
      "dot": "amber",
      "title": "版本身份与修订条件",
      "items": [
        "硬检查失败＝blocked；硬检查通过但缺材料 / 定义 / 检索结果＝pending_review；均无记录缺口＝formal。",
        "同一报告期内补件、纠错、改稿产生新运行与新修订；新期间、授信事项或评价基准建立关联新项目。",
        "图中“重评影响”发生在新运行的 draft plan；新增要点若改变已冻结章节计划，须取消旧未发布运行后重开。",
        "复用按证据、计算和章节依赖判断；锁定冲突需处理，不能沿用已失效结论。"
      ]
    },
    {
      "dot": "rose",
      "title": "可运行能力不等于业务签认",
      "items": [
        "核心只用 reviewer_id 与作者 ID 区分审阅者；真实独立上下文及专业语义复核由宿主保证。",
        "当前发布实现统一依赖 LibreOffice，授信/薪酬 YAML 的 PDF 可选声明尚未反映到执行路径。",
        "本图依据当前未提交文件的本地快照；真实供应商、宿主自主写作、真实规模与最终逐页版式仍待验收。"
      ]
    }
  ],
