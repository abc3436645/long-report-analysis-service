    "subject_model": "workforce_groups",
    "time_model": "analysis_and_comparison_periods",
    "inputs": [
      {
        "id": "payroll",
        "required": true,
        "kinds": [
          "xlsx",
          "csv"
        ]
      },
      {
        "id": "roster",
        "required": true,
        "kinds": [
          "xlsx",
          "csv"
        ]
      },
      {
        "id": "productivity_sources",
        "required": false,
        "kinds": [
          "xlsx",
          "csv"
        ]
      }
    ],
    "retrieval": {
      "enabled": false,
      "task_refs": []
    },
    "outline": "outline.yaml",
    "analysis": "analysis.yaml",
    "quality": "quality.yaml",
    "template": "templates/default-v0.1.0.docx",
    "delivery": {
      "required_formats": [
        "md",
        "docx"
      ],
      "optional_formats": [
        "pdf"
      ]
    },
    "business_definitions": {
      "pay_components": "base,bonus",
      "accounting_basis": "accrual",
      "headcount_or_fte_rule": "distinct_people_at_period_end",
      "productivity_formula": null,
      "minimum_group_size": 3
    },
    "definition_missing": [
      "productivity_formula"
    ],
    "overridable_fields": {
      "business_definitions.pay_components": {
        "type": "string",
        "min_length": 1
      },
      "business_definitions.accounting_basis": {
        "type": "string",
        "min_length": 1
      },
      "business_definitions.headcount_or_fte_rule": {
        "type": "string",
        "min_length": 1
      },
      "business_definitions.productivity_formula": {
        "type": "string",
        "min_length": 1
      },
      "business_definitions.minimum_group_size": {
        "type": "integer",
        "minimum": 2
      }
    }
  },
