        "id": "actuals",
        "required": true,
        "kinds": [
          "xlsx",
          "csv"
        ]
      },
      {
        "id": "budget",
        "required": true,
        "kinds": [
          "xlsx",
          "csv"
        ]
      },
      {
        "id": "prior_period",
        "required": false,
        "kinds": [
          "xlsx",
          "csv"
        ]
      },
      {
        "id": "explanations",
        "required": false,
        "kinds": [
          "docx",
          "pdf",
          "txt"
        ]
      }
    ],
    "retrieval": {
      "enabled": false,
      "task_refs": []
