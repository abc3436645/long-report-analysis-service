        "label": "变动金属成本"
      },
      "processed": {
        "prior": "processed_prior",
        "label": "选矿处理量"
      },
      "labor_depr": {
        "prior": "labor_depr_prior",
        "label": "人工及折旧"
      },
      "metal": {
        "prior": "metal_prior",
        "label": "金属折合量"
      },
      "sales": {
