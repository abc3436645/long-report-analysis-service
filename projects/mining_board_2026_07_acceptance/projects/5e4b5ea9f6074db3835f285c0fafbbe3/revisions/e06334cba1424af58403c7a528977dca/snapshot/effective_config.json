    "outline": "outline.yaml",
    "analysis": "analysis.yaml",
    "quality": "quality.yaml",
    "template": "templates/default-v0.2.0.docx",
    "presentation": {
      "body_font": "Songti SC",
      "heading_font": "Heiti SC",
      "latin_font": "Times New Roman"
    },
    "delivery": {
