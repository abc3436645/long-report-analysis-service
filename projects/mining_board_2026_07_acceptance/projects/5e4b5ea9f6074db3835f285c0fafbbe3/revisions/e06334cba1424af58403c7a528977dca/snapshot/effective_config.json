        "label": "产品或专项效益"
      },
      "fee": {
        "prior": "fee_prior",
        "label": "加工费"
      },
      "cost": {
        "prior": "cost_prior",
        "label": "单位成本"
      },
      "operating": {
        "prior": "operating_prior",
        "label": "生产经营效益"
      },
      "hedge": {
        "prior": "hedge_prior",
        "label": "保值影响"
      },
      "provisional": {
        "prior": "provisional_prior",
        "label": "暂估影响"
      },
      "ytd": {
        "prior": "prior",
        "label": "累计效益"
      }
    },
    "analysis_tasks": [
      {
        "id": "performance_review",
        "goal": "区分已证实的表现、原因假设、问题和建议"
      }
