  "analysis": {
    "evidence_selectors": [
      {
        "id": "actual_amount",
        "input": "actuals",
        "field": "amount",
        "dimensions": [
          "subject",
          "period",
          "metric",
          "unit"
        ]
      },
      {
        "id": "budget_amount",
        "input": "budget",
        "field": "amount",
        "dimensions": [
          "subject",
          "period",
          "metric",
          "unit",
          "budget_version"
        ]
      }
    ],
    "metrics": [
      {
        "id": "budget_difference",
        "label": "较预算差额",
        "operator": "difference",
        "inputs": [
          "actual_amount",
          "budget_amount"
        ],
        "applies_to": [
          "profit_total"
        ],
        "parameters": {
          "requires_same_subject_period_metric_unit": true
        }
      },
      {
        "id": "budget_completion_rate",
        "label": "预算完成率",
        "operator": "positive_base_completion_rate",
        "inputs": [
          "actual_amount",
          "budget_amount"
        ],
        "applies_to": [
          "profit_total"
        ],
        "parameters": {
          "requires_same_subject_period_metric_unit": true,
          "unit": "percent"
        }
      }
    ],
    "period_comparisons": [
      {
        "id": "month_change",
        "label": "较上月差额",
        "operator": "difference",
        "basis": "actuals",
        "window": "month",
        "baseline": "previous_month",
        "applies_to": [
          "profit_total"
        ]
      },
      {
        "id": "ytd_change",
        "label": "累计同比差额",
        "operator": "difference",
        "basis": "actuals",
        "window": "ytd",
        "baseline": "previous_year_same_month",
        "applies_to": [
          "profit_total"
        ]
      },
      {
        "id": "month_change_rate",
        "label": "环比变化率",
        "operator": "positive_base_change_rate",
        "basis": "actuals",
        "window": "month",
        "baseline": "previous_month",
        "applies_to": [
          "profit_total"
        ]
      },
      {
        "id": "ytd_change_rate",
        "label": "累计同比变化率",
        "operator": "positive_base_change_rate",
        "basis": "actuals",
        "window": "ytd",
        "baseline": "previous_year_same_month",
        "applies_to": [
          "profit_total"
        ]
      },
      {
        "id": "annual_plan_completion_rate",
        "label": "年度计划完成率",
        "operator": "positive_base_completion_rate",
        "basis": "actuals",
        "baseline_basis": "budget",
        "window": "ytd",
        "baseline": "annual_plan",
        "applies_to": [
          "profit_total"
        ]
      }
    ],
    "paired_indicators": {
      "ore_cost": {
        "prior": "ore_cost_prior",
        "label": "吨矿成本"
      },
      "variable": {
        "prior": "variable_prior",
        "label": "变动吨矿成本"
      },
      "metal_cost": {
